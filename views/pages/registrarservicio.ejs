<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head'); %>
</head>
<body class="container">

<header>
    <%- include('../partials/header'); %>
</header>

<div class="container mt-3">

    <h2>Registrar Servicio</h2>

    <form action="/servicios" method="POST">

        <div class="mb-3">
            <label>Nombre:</label>
            <input
                type="text"
                class="form-control"
                name="nombre"
                required>
        </div>

        <div class="mb-3">
            <label>Precio:</label>
            <input
                type="number"
                class="form-control"
                name="precio"
                required>
        </div>

        <div class="mb-3">
            <label>Duración (minutos):</label>
            <input
                type="number"
                class="form-control"
                name="duracionMinutos"
                required>
        </div>

        <button type="submit" class="btn btn-primary">
            Guardar Servicio
        </button>

    </form>

</div>

</body>
</html>