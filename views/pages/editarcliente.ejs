<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head'); %>
</head>
<body class="container">

<div class="container mt-3">
    <h2>Editar Cliente</h2>

    <form action="/clientes/editar/<%= cliente._id %>" method="POST">

        <div class="mb-3">
            <label>Nombre</label>
            <input
                type="text"
                class="form-control"
                name="nombre"
                value="<%= cliente.nombre %>">
        </div>

        <div class="mb-3">
            <label>Email</label>
            <input
                type="email"
                class="form-control"
                name="email"
                value="<%= cliente.email %>">
        </div>

        <div class="mb-3">
            <label>Teléfono</label>
            <input
                type="number"
                class="form-control"
                name="telefono"
                value="<%= cliente.telefono %>">
        </div>

        <button type="submit" class="btn btn-success">
            Guardar Cambios
        </button>

    </form>
</div>

</body>
</html>