<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/head'); %>
</head>

<body class="container">

    <header>
        <%- include('../partials/header'); %>
    </header>

    <main>

        <div class="mt-4">
            <h1>Productos</h1>
            <table id="tabla" class="table table-striped">
                <thead>
                    <tr>
                        <th>Stock</th>
                        <th>Nombre</th>
                        <th>Precio</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <% productos.forEach(function(producto) { %>
                        <tr>
                            <td>
                                <%= producto.stock %>
                            </td>
                            <td>
                                <%= producto.nombre %>
                            </td>
                            <td>
                                <%= producto.precio %>
                            </td>
                            <td>
                                <a href="/productos/editar/<%= producto._id %>"
                                    class="btn btn-warning btn-sm">Editar</a>
                                <a href="/productos/eliminar/<%= producto._id %>" class="btn btn-danger btn-sm"
                                    onclick="return confirm('¿Deseas eliminar este cliente?')">
                                    Eliminar
                                </a>
                                
                                <button data-bs-toggle="modal" data-bs-target="#detalleProducto<%= producto._id %>">
                                    Ver detalle
                                </button>
                            </td>
                        </tr>
                        <div class="modal fade" id="detalleProducto<%= producto._id %>" tabindex="-1">

                            <div class="modal-dialog">
                                <div class="modal-content">

                                    <div class="modal-header">
                                        <h5 class="modal-title">
                                            Detalle del Producto
                                        </h5>

                                        <button type="button" class="btn-close" data-bs-dismiss="modal">
                                        </button>
                                    </div>

                                    <div class="modal-body">
                                        <p><strong>Nombre:</strong>
                                            <%= producto.nombre %>
                                        </p>
                                        <p><strong>Precio:</strong>
                                            <%= producto.precio %>
                                        </p>
                                        <p><strong>Stock:</strong>
                                            <%= producto.stock %>
                                        </p>
                                    </div>

                                    <div class="modal-footer">
                                        <button type="button" data-bs-dismiss="modal">
                                            Cerrar
                                        </button>
                                    </div>

                                </div>
                            </div>

                        </div>
                        <% }); %>
                </tbody>
            </table>
        </div>
    </main>

    <footer>
        <%- include('../partials/footer'); %>
    </footer>

</body>

</html>